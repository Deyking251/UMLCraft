# Local development uses a durable JSON store under .data/ when this is true.
CRACK_UML_LOCAL_BACKEND=true
CRACK_UML_LOCAL_DATA_PATH=.data/projects.json
CRACK_UML_SESSION_SECRET=replace-with-a-long-random-value

# Production requires the Postgres migration in replica/schema.sql and a real
# Auth.js/session adapter before setting this value.
DATABASE_URL=
